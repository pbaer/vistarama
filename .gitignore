# ---------------------------------------------------------------------------
# Data. Everything under data/ is derived from public sources by the scripts in
# this repo, and it is far too big for git: the Alpine Lakes AOI alone is ~15 GB
# (a 7.7 GB NAIP mosaic, a 0.9 GB Sentinel-2 mosaic, ~200k raster tiles).
#
# Rebuild it with:
#   python scripts/download.py alpine-lakes
#   python scripts/imagery.py --slug alpine-lakes
#   python scripts/prominence.py
#   python scripts/process.py alpine-lakes
#
# The AOI definitions themselves ARE tracked — they are the inputs, not the
# outputs, and they are what makes a rebuild reproducible.
# ---------------------------------------------------------------------------
data/*
!data/aoi/
!data/README.md
data/imagery.log

# Where this machine keeps the data, if not in data/ (see scripts/aoi.py):
#   {"data_root": "C:/data/vistarama"}
vistarama.local.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# editors / OS
.DS_Store
Thumbs.db
*.swp

# local-only agent settings; .claude/launch.json is tracked so the dev server
# config travels with the repo
.claude/settings.local.json
